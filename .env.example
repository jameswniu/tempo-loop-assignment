# GitHub read-only access. A classic PAT with no scopes ticked works for public
# repositories and lifts the rate limit from 60 to 5000 requests per hour.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Narrative endpoint. Anthropic is the shipped default and the only key you need.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# The second provider. Used on the request path when LLM_PROVIDER=openai, and by
# the eval harness to compare two models on the same frozen cases.
OPENAI_API_KEY=

# Point the OpenAI-compatible adapter somewhere else. Anything speaking the same
# chat API works, so long as it honours response_format json_schema.
# Alibaba DashScope: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=

PORT=8080
# Loopback by default. The process holds a GitHub token, so listening on every
# interface should be a deliberate choice. Docker sets this to 0.0.0.0.
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional on loopback, required if HOST is anything else. Both endpoints spend
# real money, so a reachable instance must not be open. 16 characters or more.
API_TOKEN=

# The address this process's port is published on by whatever sits in front of
# it. docker-compose.yml uses one variable for both the port mapping and this,
# so publishing wider automatically requires API_TOKEN. Leave blank locally.
PUBLISHED_ON=
LOG_LEVEL=info
CACHE_PATH=./data/cache.db
CACHE_TTL_SECONDS=900
