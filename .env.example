# GitHub read-only access. A classic PAT with no scopes ticked works for public
# repositories and lifts the rate limit from 60 to 5000 requests per hour.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Narrative endpoint. Anthropic is the shipped default and the only key you need.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# Optional. Only read by the eval harness, which compares providers on the same
# frozen cases. The service never calls OpenAI on a request path.
OPENAI_API_KEY=

PORT=8080
# Loopback by default. The process holds a GitHub token, so listening on every
# interface should be a deliberate choice. Docker sets this to 0.0.0.0.
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional on loopback, required if HOST is anything else. Both endpoints spend
# real money, so a reachable instance must not be open. 16 characters or more.
API_TOKEN=
LOG_LEVEL=info
CACHE_PATH=./data/cache.db
CACHE_TTL_SECONDS=900
